Table issue_category {
  category_id serial [pk]
  category_name varchar(60) [not null, unique]
  default_priority varchar(10) [not null]
  is_active boolean [not null, default: true]
}

Table technician {
  technician_id bigserial [pk]
  technician_code varchar(20) [not null, unique]
  ho_ten varchar(120) [not null]
  center_id bigint [not null, note: 'external service_center master data']
  level varchar(10) [not null]
  is_active boolean [not null, default: true]
}

Table technician_skill {
  technician_id bigint [not null, ref: > technician.technician_id]
  category_id int [not null, ref: > issue_category.category_id]
  proficiency smallint [not null, note: 'CON-04: 1..5; QT-08 eligibility >= 3']
  Indexes { (technician_id, category_id) [pk] }
}

Table ticket {
  ticket_id bigserial [pk]
  ticket_code varchar(20) [not null, unique]
  center_id bigint [not null, note: 'QT-14 scoping; external master']
  customer_name varchar(120) [not null, note: 'snapshot']
  customer_phone varchar(20) [not null, note: 'snapshot; QT-15 masking']
  serial_no varchar(50) [not null, note: 'device snapshot; QT-03 enforced in L2']
  issue_desc text [not null]
  category_id int [not null, ref: > issue_category.category_id]
  priority varchar(10) [not null]
  status varchar(20) [not null, note: 'QT-06 lifecycle values']
  technician_id bigint [ref: > technician.technician_id, note: 'QT-07; NULL = unassigned']
  received_at timestamptz [not null]
  due_date timestamptz [not null, note: 'QT-04 generated by L2']
  closed_at timestamptz
  is_warranty boolean [not null]
  is_deleted boolean [not null, default: false, note: 'QT-13 soft delete']
}

Table appointment {
  appointment_id bigserial [pk]
  ticket_id bigint [not null, ref: > ticket.ticket_id]
  technician_id bigint [not null, ref: > technician.technician_id, note: 'scheduling-time snapshot']
  center_id bigint [not null, note: 'scheduling-time snapshot']
  loai varchar(20) [not null, note: 'CON-02']
  trang_thai varchar(20) [not null, note: 'CON-03']
  ngay_hen date [not null]
  gio_bat_dau time [not null]
  gio_ket_thuc time [not null, note: 'CON-01 end > start']
  is_deleted boolean [not null, default: false, note: 'TD-05 soft delete; excluded from default list/conflict']
}

Table ticket_status_log {
  log_id bigserial [pk]
  ticket_id bigint [not null, ref: > ticket.ticket_id]
  from_status varchar(20)
  to_status varchar(20) [not null]
  changed_at timestamptz [not null, default: `now()`]
  changed_by bigint [not null, note: 'external employee identity']
  note varchar(255) [note: 'QT-07 reassignment reason']
}
