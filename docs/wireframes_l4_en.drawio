        <mxCell id="16" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;fontSize=12;fillColor=#FFF9E6;strokeColor=#B8860B;" value="M1 annotations&#xa;Screen type: List.&#xa;Field→column: every table column is a ticket column, or issue_category.category_name via FK; customer_phone shown FULL (Center Manager, QT-15).&#xa;Actions: [Assign] opens M2 (UC3 entry); [Apply filters] = FR9.&#xa;States: empty state = US1 AC2 (AC-driven visible state, not a written exception flow); generic message area covers unexpected errors incl. 403 (the 403 itself is documented in the API contract).&#xa;UC1 has no written exception flows, so no further error slots are required (check-6 obligation set = written flows of UC3/UC4)." vertex="1">
          <mxGeometry height="200" width="340" x="80" y="530" as="geometry" />
        </mxCell>
