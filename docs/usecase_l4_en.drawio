        <mxCell id="30" value="Legend&#10;— solid line: actor participates in the use case&#10;— dashed arrow: «include» (always invoked)&#10;— «deferred»: specified but NOT implemented in v0.5&#10;UC3 always invokes UC2 (eligibility check, QT-08).&#10;Appointment conflict detection (FR7, US6) is an&#10;exception flow inside UC4, not a separate use case." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;fillColor=#FFF9E6;strokeColor=#B8860B;" vertex="1" parent="1">
          <mxGeometry x="950" y="60" width="300" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="31" value="Non-human actors considered: Time / Scheduler.&#10;Ruled out because L4 contains no time-triggered&#10;use case — due dates are generated at ticket&#10;creation (L2), not at assignment." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;fillColor=#FFF9E6;strokeColor=#B8860B;" vertex="1" parent="1">
          <mxGeometry x="950" y="220" width="300" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="32" value="v0.5 implements UC1–UC4 for Center Manager.&#10;UC5 deferred (US10 COULD); UC6 deferred to v1.1 (US7).&#10;Customer is a stakeholder only (US11 WON'T),&#10;therefore not drawn as an actor." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;fillColor=#FFF9E6;strokeColor=#B8860B;" vertex="1" parent="1">
          <mxGeometry x="950" y="340" width="300" height="100" as="geometry"/>
