# Copy to .env:  cp .env.example .env
# .env is gitignored. These are sample values for local development only.

# --- PostgreSQL ---------------------------------------------------------------
# Native run: point at your local PostgreSQL 16 (README step 3 creates the DB).
# Docker run: docker-compose.yml overrides DB_HOST/DB_PORT to reach the "db" container.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mekong_l4
DB_USER=postgres
DB_PASSWORD=postgres
DB_CONNECT_TIMEOUT=3

# --- API ----------------------------------------------------------------------
PORT=8000
# Key that signs login tokens. Leave EMPTY for the demo: the API then makes a random
# key each time it starts (users log in again after a restart). To keep logins across
# restarts, set your own random string of 32+ characters, e.g. the output of
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit a real value; sample values published in this repository are refused.
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Password of the two demo accounts (manager1, manager2), set by scripts/seed.py when the
# accounts are first created. Only its PBKDF2 hash is stored (table app_user).
# Demo value, published on purpose; set your own before any real use.
DEMO_PASSWORD=manager123
# Business timezone for the "appointment must be in the future" rule.
APP_TIMEZONE=Asia/Ho_Chi_Minh
# Frontend origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
# Hosting platforms (Render, docs/deployment-guide.md §9) give the database as one URL that
# replaces the DB_* values above. Leave it unset for local and Docker runs.
# DATABASE_URL=postgresql://user:password@host:5432/mekong_l4

# --- Docker only (docker compose) ---------------------------------------------
API_PORT=8000
WEB_PORT=5173
DOCKER_DB_PORT=5433
