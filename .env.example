# Copy to .env:  cp .env.example .env
# .env is gitignored. These are sample values for local development only.

# --- PostgreSQL ---------------------------------------------------------------
# Native run: point at your local PostgreSQL 16 (README step 3 creates the DB).
# Docker run: docker-compose.yml overrides DB_HOST/DB_PORT to reach the "db" container.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mekong_l4
DB_USER=postgres
DB_PASSWORD=postgres
DB_CONNECT_TIMEOUT=3

# --- API ----------------------------------------------------------------------
PORT=8000
# Demo login tokens are signed with this key. Use any long random string.
JWT_SECRET=change_me_to_a_long_random_string_32_chars_min
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Business timezone for the "appointment must be in the future" rule.
APP_TIMEZONE=Asia/Ho_Chi_Minh
# Frontend origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# --- Docker only (docker compose) ---------------------------------------------
API_PORT=8000
WEB_PORT=5173
DOCKER_DB_PORT=5433
