# ============================================================
# .gitignore — L4 Technician Assignment and Appointment Scheduling
# Stack: Python 3.11+ / FastAPI / psycopg 3 / PostgreSQL 16
#        React (Vite) / pytest / Docker
# Rule: NEVER commit secrets, local env, build artifacts,
#       large datasets, or IDE-specific configs.
# ============================================================

# Python / FastAPI backend
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
.venv/
env/
ENV/
.python-version

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.tox/
.nox/
.hypothesis/

# Type checking / linting caches
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.cache/

# Jupyter (just in case when used for exploration)
.ipynb_checkpoints/

# React (Vite) frontend
node_modules/
dist/
dist-ssr/
*.local
.vite/
.vite-cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.eslintcache

# Environment / secrets
# Keep .env.example in Git; never commit .env !!!
.env
.env.*
!.env.example

# Databases / local data
# No local DB files, dumps, or large datasets in Git
*.sqlite
*.sqlite3
*.db
*.sql
*.dump
*.parquet
*.feather
# Exception for Docs
!docs/*.sql
# Exception for Migrations
!db/migrations/*.sql

# Case study datasets (Only commit small samples)
# Keep data/sample/ tracked; ignore everything else under data/
data/*
!data/sample/
!data/sample/**

# Docker / runtime
# Nothing special to ignore; Dockerfiles are tracked.
# Local overrides only:
docker-compose.override.yml
*.pid
*.seed
*.pid.lock

# IDE / editor
.idea/
.vscode/
!.vscode/extensions.json
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Logs / temp
*.log
logs/
tmp/
temp/

# Misc build / cache
.cache/
build/
dist/
